%项目_start%
    %数据库_start%
        &主机: "localhost"
        &端口: 3306
        &用户名: "root"
        &密码: "123456"
    %数据库_end%
    %缓存_start%
        &类型: "redis"
        &地址: "127.0.0.1:6379"
        &过期时间: 3600
    %缓存_end%
    %用户_start%
        %admin_start%
            &密码: "123456"
            &权限: "管理员"
        %admin_end%
    %用户_end%
    &调试模式: true
    &日志级别: "info"
%项目_end%